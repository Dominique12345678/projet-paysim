# Configuration de la base de données PostgreSQL sur Render
# Récupérez ces informations sur votre tableau de bord Render -> votre base PostgreSQL

# Option 1: URL de connexion complète (External Database URL fournie par Render)
DATABASE_URL=postgresql://user:password@dpg-xxxxxxxxxx.oregon-postgres.render.com/dbname

# Option 2: Paramètres individuels (si besoin)
DB_HOST=dpg-xxxxxxxxxx.oregon-postgres.render.com
DB_PORT=5432
DB_NAME=paysim_dwh
DB_USER=paysim_user
DB_PASSWORD=votre_mot_de_passe
